# Vector Database Settings
VECTOR_DB_PATH=./data/vector_store
VECTOR_COLLECTION_NAME=electronics_knowledge

# Embedding Model Configuration
# Options: sentence-transformers (local) or mock/custom
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Document Processing Defaults
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# MCP Server Configuration
MCP_SERVER_NAME=electronics-rag-mcp
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
MCP_TRANSPORT=stdio

# UI Configuration (Setup & Tools inspection only)
UI_PORT=8501
